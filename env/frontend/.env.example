# Public application metadata
NEXT_PUBLIC_APP_NAME='Dreamday'
NEXT_PUBLIC_APP_DEFAULT_TITLE='Dreamday'
NEXT_PUBLIC_APP_TITLE_TEMPLATE='%s - Dreamday'
NEXT_PUBLIC_APP_DESCRIPTION='Dreamday travel planning'
NEXT_PUBLIC_APP_URL='http://dreamday.local'

# Runtime behavior
MAINTENANCE_MODE=false

# Backend API (server-only). Use http://backend:8000 inside Compose.
API_BASE_URL='http://backend:8000'

# Optional CSP img-src origins (comma-separated). Covers are same-origin via
# /api/trips/{id}/cover, so this can stay empty for the local stack.
NEXT_PUBLIC_MEDIA_ORIGINS=

# Development server
# Optional comma-separated hostnames allowed to access the Next.js dev server.
NEXT_DEV_ALLOWED_ORIGINS=dreamday.local,api.dreamday.local,media.dreamday.local
