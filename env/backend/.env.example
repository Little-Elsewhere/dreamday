# Local development settings for the root Compose stack.
APP_NAME="Dreamday Backend"
APP_DEBUG=true

# Database (the backend-db Compose service)
DB_HOST=backend-db
DB_PORT=5432
POSTGRES_USER=dreamday
POSTGRES_PASSWORD=dreamday
POSTGRES_DB=dreamday

# Authentication and tokens
# Generate with: python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
JWT_SECRET_KEY=
JWT_ISSUER=dreamday-api
JWT_AUDIENCE=dreamday-client
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# Email verification (opened in the host browser via Nginx)
EMAIL_VERIFICATION_TOKEN_EXPIRE_MINUTES=60
EMAIL_VERIFICATION_RESEND_COOLDOWN_SECONDS=60
EMAIL_VERIFICATION_URL=http://dreamday.local/en/auth/confirm

# Password reset
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=60
PASSWORD_RESET_RESEND_COOLDOWN_SECONDS=60
PASSWORD_RESET_URL=http://dreamday.local/en/auth/reset-password

# SMTP (the backend-mailpit Compose service)
SMTP_HOST=backend-mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=false
SMTP_START_TLS=false
SMTP_TIMEOUT_SECONDS=10
SMTP_FROM_EMAIL=noreply@example.com
SMTP_FROM_NAME=Dreamday

# Object storage (S3-compatible). Local Compose uses RustFS; keep the bucket private.
# Covers are streamed through the API (/api/v1/trips/{id}/cover), not anonymous S3 URLs.
# For production Cloudflare R2, keep the same keys and only change values, e.g.:
#   S3_ENDPOINT_URL=https://<accountid>.r2.cloudflarestorage.com
#   S3_REGION=auto
S3_ENDPOINT_URL=http://backend-rustfs:9000
S3_ACCESS_KEY=rustfsadmin
S3_SECRET_KEY=rustfsadmin
S3_BUCKET=dreamday-covers
# Retained for Settings compatibility; browser access does not use this URL.
S3_PUBLIC_BASE_URL=http://media.dreamday.local/dreamday-covers
S3_REGION=us-east-1
