# Local development settings for the root Compose stack.
APP_NAME="Dreamday Backend"
APP_DEBUG=true

# Database (the backend-db Compose service)
DB_HOST=backend-db
DB_PORT=5432
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# Authentication and tokens
JWT_SECRET_KEY=
JWT_ISSUER=dreamday-api
JWT_AUDIENCE=dreamday-client
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# Email verification
EMAIL_VERIFICATION_TOKEN_EXPIRE_MINUTES=60
EMAIL_VERIFICATION_RESEND_COOLDOWN_SECONDS=60
EMAIL_VERIFICATION_URL=http://localhost:4000/en/auth/confirm

# SMTP (the backend-mailpit Compose service)
SMTP_HOST=backend-mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=false
SMTP_START_TLS=false
SMTP_TIMEOUT_SECONDS=10
SMTP_FROM_EMAIL=noreply@dreamday.local
SMTP_FROM_NAME=Dreamday
